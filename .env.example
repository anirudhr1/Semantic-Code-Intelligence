# ── Model ────────────────────────────────────────────────────────────────────
# sentence-transformers model used for embedding code chunks.
# Any model from https://www.sbert.net/docs/pretrained_models.html works here.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where FAISS index, BM25 index, and chunk metadata are persisted.
INDEX_DIR=data/index

# Directory where remote git repositories are cloned.
REPOS_DIR=data/repos

# ── Ranking weights ───────────────────────────────────────────────────────────
# The three weights must sum to 1.0.
# Semantic cosine similarity score weight.
SEMANTIC_WEIGHT=0.6
# BM25 keyword score weight.
BM25_WEIGHT=0.3
# Exact / fuzzy symbol-name match bonus weight.
SYMBOL_WEIGHT=0.1

# ── Search defaults ───────────────────────────────────────────────────────────
DEFAULT_TOP_K=10

# ── API ───────────────────────────────────────────────────────────────────────
# Host and port for the FastAPI server (used by Uvicorn in Docker).
API_HOST=0.0.0.0
API_PORT=8000
